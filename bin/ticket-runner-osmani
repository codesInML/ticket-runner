#!/usr/bin/env bash
# The ticket runner on the Osmani workflow (Addy Osmani's agent skills, with a per-ticket review
# by another model family). See --help.
set -euo pipefail
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"; src="$(readlink "$src")"; [[ $src == /* ]] || src="$dir/$src"
done
exec "$(cd -P "$(dirname "$src")" && pwd)/ticket-runner" --workflow osmani "$@"
