#!/usr/bin/env bash
# Every session uses the operator's ChatGPT subscription. Composes with --workflow osmani. See --help.
set -euo pipefail
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"; src="$(readlink "$src")"; [[ $src == /* ]] || src="$dir/$src"
done
exec "$(cd -P "$(dirname "$src")" && pwd)/ticket-runner" --backend codex "$@"
